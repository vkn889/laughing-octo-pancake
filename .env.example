# Only needed to run against Supabase instead of the local JSON file (see
# README "Deploying to Vercel"). Leave unset for local dev/laptop hosting.
#
# From your Supabase project: Settings -> API -> Project URL, and the
# anon/publishable key (Settings -> API -> Project API keys). This is the
# anon key, not the service_role key: the `teams` table's Row Level
# Security policies scope it to exactly what the app needs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
