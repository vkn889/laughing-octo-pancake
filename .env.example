# Only needed to run against Redis instead of the local JSON file (see
# README "Deploying to Vercel"). Leave unset for local dev/laptop hosting.
#
# Vercel's dashboard (Project -> Storage -> Connect Database -> Redis)
# injects KV_REST_API_URL / KV_REST_API_TOKEN automatically once you
# connect a store; you don't need to set these by hand there. Set them
# here only for local testing against a Redis instance, or if you're using
# a store you created directly in the Upstash console (which uses the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names instead; either
# pair works).
KV_REST_API_URL=
KV_REST_API_TOKEN=
